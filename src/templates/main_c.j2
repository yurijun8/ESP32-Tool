// Bibliotecas necessárias
#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
{% for lib in libraries %}
{{ lib }}
{% endfor %}

{% if pin_definitions %}
// Definição dos pinos utilizados
{% for def_line in pin_definitions %}
{{ def_line }}
{% endfor %}
